####### Transition

- TO :: Seeded
- ON :: seed

###### Seeded

####### Transition

- TO :: Prepared
- ON :: prepare

###### Prepared

####### Transition

- TO :: Proposed
- ON :: propose

###### Proposed

####### Transition

- TO :: Unknown
- ON :: submitUnknown

####### Transition

- TO :: Confirmed
- ON :: submitConfirmed

####### Transition

- TO :: Rejected
- ON :: rejected

####### Transition

- TO :: Conflict
- ON :: conflict

###### Unknown

####### Transition

- TO :: Confirmed
- ON :: queryConfirmed

####### Transition

- TO :: Rejected
- ON :: rejected

####### Transition

- TO :: Conflict
- ON :: conflict

